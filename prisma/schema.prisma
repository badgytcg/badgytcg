// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js required models ---
// https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]
  wishlistItems WishlistItem[]
  orders        Order[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  cardId    String? // null if the card isn't in our catalog at all
  cardName  String
  qty       Int
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Purchase history. Populated once checkout/payments are wired up;
// the schema is ready ahead of that so profile pages have somewhere to read from.
model Order {
  id         String      @id @default(cuid())
  userId     String
  status     String      @default("pending") // pending | paid | fulfilled | cancelled
  totalCents Int
  createdAt  DateTime    @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  cardId     String
  cardName   String
  qty        Int
  priceCents Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
