// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js required models ---
// https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]
  wishlistItems WishlistItem[]
  orders        Order[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  cardId    String? // null if the card isn't in our catalog at all
  cardName  String
  qty       Int
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Purchase history, created by the Stripe webhook once a checkout session
// completes. userId is null for guest checkouts — guestEmail is what we
// have to go on for those instead.
model Order {
  id              String      @id @default(cuid())
  userId          String?
  guestEmail      String?
  stripeSessionId String      @unique
  status          String      @default("pending") // pending | paid | fulfilled | cancelled
  totalCents      Int
  createdAt       DateTime    @default(now())

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  cardId     String
  cardName   String
  qty        Int
  priceCents Int
  owner      String @default("badgy") // snapshot of consigner at time of sale

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// Consigners who stock cards through the shop. "badgy" is always the default
// owner (the shop owner). Slug must be lowercase, no spaces.
model Consigner {
  slug      String   @id // "badgy", "sneakerdad"
  name      String           // "Badgy", "SneakerDad"
  email     String?
  createdAt DateTime @default(now())
}

// Live admin-editable price/stock per card, keyed by the catalog's card id
// (e.g. "eth-getrekt"). Takes priority over the seed defaults in
// src/data/overrides.json so admins can update inventory without a deploy.
model CardOverride {
  cardId    String   @id
  price     Float
  stock     Int
  owner     String   @default("badgy") // which consigner owns this stock
  updatedAt DateTime @updatedAt
}

// Cached prices scraped/pulled from other marketplaces, refreshed via the
// "Refresh Market Prices" admin action rather than on every page view.
// Always holds just the latest value per cardId+source.
model MarketPrice {
  id        String   @id @default(cuid())
  cardId    String
  source    String // "dyli" | "minmax"
  label     String // human-readable, e.g. "Dyli"
  price     Float
  currency  String
  url       String?
  updatedAt DateTime @updatedAt

  @@unique([cardId, source])
}

// Append-only log of every MarketPrice value seen, one row per refresh per
// cardId+source. This is what powers price charts and gainers/decliners —
// MarketPrice itself only ever holds the latest value, not a history.
model MarketPriceHistory {
  id         String   @id @default(cuid())
  cardId     String
  source     String // "dyli" | "minmax" | "site"
  price      Float
  currency   String
  recordedAt DateTime @default(now())

  @@index([cardId, source, recordedAt])
}

// A foil/alt-foil copy of a catalog card. `kind` is "foil" or "altfoil" —
// only exists once an admin has actually stocked that variant; the toggle
// on a card's tile/detail page only shows the tiers that have a row here.
model CardVariantOverride {
  cardId    String
  kind      String // "foil" | "altfoil"
  price     Float
  stock     Int
  updatedAt DateTime @updatedAt

  @@id([cardId, kind])
}

// Manually-curated one-off inventory: graded slabs, special/rare foils, etc.
// that aren't part of the regular 548-card catalog. Admin sets qty directly
// (e.g. 10 copies of the same promo) rather than adding 10 separate rows;
// remove the row once the last one sells.
model SpecialCard {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String
  price       Float
  grade       String? // e.g. "PSA 9", "Beckett 9.5"
  set         String?
  qty         Int      @default(1)
  createdAt   DateTime @default(now())
}

// Append-only record of every admin mutation (price/stock changes, customer
// emails sent, order status changes, etc.) so unauthorized or mistaken
// changes can be traced back to a specific account and time. Never updated
// or deleted by the app — only ever inserted into.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String // short machine-readable tag, e.g. "inventory.bulk_update"
  detail     String // human-readable summary of what changed
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
