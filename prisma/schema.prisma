// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js required models ---
// https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]
  wishlistItems WishlistItem[]
  orders        Order[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  cardId    String? // null if the card isn't in our catalog at all
  cardName  String
  qty       Int
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Purchase history, created by the Stripe webhook once a checkout session
// completes. userId is null for guest checkouts — guestEmail is what we
// have to go on for those instead.
model Order {
  id              String      @id @default(cuid())
  userId          String?
  guestEmail      String?
  stripeSessionId String      @unique
  status          String      @default("pending") // pending | paid | fulfilled | cancelled
  totalCents      Int
  createdAt       DateTime    @default(now())

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  cardId     String
  cardName   String
  qty        Int
  priceCents Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// Live admin-editable price/stock per card, keyed by the catalog's card id
// (e.g. "eth-getrekt"). Takes priority over the seed defaults in
// src/data/overrides.json so admins can update inventory without a deploy.
model CardOverride {
  cardId    String   @id
  price     Float
  stock     Int
  updatedAt DateTime @updatedAt
}

// Cached prices scraped/pulled from other marketplaces, refreshed via the
// "Refresh Market Prices" admin action rather than on every page view.
model MarketPrice {
  id        String   @id @default(cuid())
  cardId    String
  source    String // "dyli" | "minmax"
  label     String // human-readable, e.g. "Dyli"
  price     Float
  currency  String
  url       String?
  updatedAt DateTime @updatedAt

  @@unique([cardId, source])
}

// Foil copy of a catalog card, keyed by the base card's id. Only exists once
// an admin has actually stocked a foil of that card — the toggle on a card's
// detail page only shows up when a row is present here.
model FoilOverride {
  cardId    String   @id
  price     Float
  stock     Int
  updatedAt DateTime @updatedAt
}

// Manually-curated one-off inventory: graded slabs, special/rare foils, etc.
// that aren't part of the regular 548-card catalog. No stock field on
// purpose — if it's listed here, it's available; admin deletes the row once
// it sells rather than zeroing out a quantity.
model SpecialCard {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String
  price       Float
  grade       String? // e.g. "PSA 9", "Beckett 9.5"
  set         String?
  createdAt   DateTime @default(now())
}
