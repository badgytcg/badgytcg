# Copy to .env and fill in real values. Never commit the real .env file.

# Postgres connection string. In Railway: add a Postgres plugin to this
# project, then copy its "Connection URL" (Variables tab) here.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random secret for signing Auth.js session tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google      (dev)
#   https://badgytcg.com/api/auth/callback/google        (prod)
# Note: Auth.js auto-reads these specific names for the Google provider —
# don't rename them to GOOGLE_CLIENT_ID/SECRET, they won't be picked up.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated Google account emails allowed into /admin and the admin APIs.
ADMIN_EMAILS=""

# From the Stripe Dashboard (Developers > API keys). Use the test-mode secret
# key (starts with sk_test_) until you're ready to take real payments.
STRIPE_SECRET_KEY=""

# From Stripe Dashboard > Developers > Webhooks > your endpoint's "Signing secret"
# (starts with whsec_). The endpoint URL to register there is:
#   https://badgytcg.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# From console.anthropic.com > Settings > API Keys. Powers /admin/scan
# (photo-to-card-name recognition for fast inventory entry).
ANTHROPIC_API_KEY=""
